{
  "name": "guitar-chords",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:catalog": "tsx scripts/validate-catalog.ts",
    "test:url-compat": "vitest run tests/url.test.ts",
    "test:e2e": "playwright test",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "measure:url": "tsx scripts/measure-url.ts",
    "catalog:import": "tsx scripts/import-chords.ts",
    "catalog:diff": "tsx scripts/catalog-diff.ts",
    "deploy:check": "wrangler deploy --dry-run --outdir .cache/worker"
  },
  "dependencies": {
    "@tonaljs/chord-type": "5.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "volta": {
    "node": "24.22.1"
  }
}
